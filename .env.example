# Kidkazz RAG Environment Variables
# Copy this file to .env and fill in your values
# .env is gitignored and will not be committed

# =============================================================================
# API Keys (secrets only - all other config goes in .kidkazz.toml)
# =============================================================================

# Reducto.ai API Key (required for PDF parsing)
# Get your key from: https://reducto.ai
REDUCTO_API_KEY=your_reducto_api_key_here

# Anthropic API Key (for Claude API access - optional)
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI API Key (for OpenAI embeddings)
# Required if using: kidkazz ingest markdown --embedder openai
# Or if config: embedder_type = "openai" in .kidkazz.toml
# OPENAI_API_KEY=sk-xxxxx

# Cohere API Key (for Cohere embeddings + reranking)
# CO_API_KEY=your_cohere_key

# MCP Server Authentication (for remote HTTP deployment)
# Set this to secure the MCP endpoint when using streamable-http transport
# KIDKAZZ_API_KEY=your_secret_key
