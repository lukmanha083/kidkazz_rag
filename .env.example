# Kidkazz RAG Environment Variables
# Copy this file to .env and fill in your values
# .env is gitignored and will not be committed

# =============================================================================
# API Keys (optional - for future integrations)
# =============================================================================

# Anthropic API Key (for Claude API access)
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI API Key (for embeddings or other services)
# OPENAI_API_KEY=sk-xxxxx

# =============================================================================
# Storage Configuration
# =============================================================================

# Storage backend: "mock" (testing) or "helix" (production)
KIDKAZZ_STORE_TYPE=mock

# Helix-DB settings (if using helix)
KIDKAZZ_HELIX_PORT=6969
KIDKAZZ_HELIX_LOCAL=true

# =============================================================================
# Embeddings Configuration
# =============================================================================

# Embedder type: "mock" (testing) or "fastembed" (production)
KIDKAZZ_EMBEDDER_TYPE=fastembed

# Embedding model
KIDKAZZ_MODEL_NAME=BAAI/bge-small-en-v1.5

# =============================================================================
# Cloud Sync (rclone)
# =============================================================================

# rclone remote name (e.g., "gdrive" for Google Drive)
KIDKAZZ_CLOUD_REMOTE=gdrive

# Remote path for PDF inbox
KIDKAZZ_CLOUD_PATH=kidkazz_inbox

# =============================================================================
# Paths
# =============================================================================

# PDF inbox directory
KIDKAZZ_INBOX_PATH=~/.kidkazz/inbox

# Markdown output directory
KIDKAZZ_OUTPUT_PATH=~/.kidkazz/output

# =============================================================================
# Logging
# =============================================================================

KIDKAZZ_LOG_LEVEL=INFO
